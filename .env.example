# CloudDrive configuration — EVERYTHING HERE IS OPTIONAL.
#
# CloudDrive runs with zero configuration: on first start it generates a strong
# random session secret, and the first time you open it in a browser it walks
# you through creating your admin account. Copy this file to `.env` only if you
# want to override one of the settings below.

# --- SESSION SECRET (optional) ---
# By default a strong random secret is generated on first run and stored at
# <storage>/.jwt_secret. Set this only to supply your own (e.g. to share one
# secret across multiple replicas). Must be >= 32 characters.
# Generate one with:  openssl rand -hex 32
# JWT_SECRET=

# --- SEED AN ADMIN NON-INTERACTIVELY (optional) ---
# Leave these blank to create your admin through the first-run web wizard.
# Set BOTH only if you're automating a deployment and want the admin created
# from env on first boot instead. Change the password in-app after first login.
# CLOUDDRIVE_USER=admin
# CLOUDDRIVE_PASS=

# --- REVERSE PROXY (optional) ---
# Comma-separated IPs/CIDRs of trusted reverse proxies (e.g. your nginx host).
# Only requests from these peers may set X-Forwarded-For / X-Real-IP; otherwise
# the rate-limiter uses the direct connection IP (prevents header-spoofed bypass).
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1

# --- OTHER (optional) ---
# Hard cap on a single upload request body, in bytes (default 5 GiB).
# MAX_UPLOAD_BYTES=5368709120

# Comma-separated allowed CORS origins (default: none / same-origin only).
# ALLOWED_ORIGINS=https://drive.example.com
